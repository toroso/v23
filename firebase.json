{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "README.md",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "regex": "^/(plan|furniture|todo|budget|images|documents)(/[^/]+)?$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "regex": "^/(plan|furniture|todo|budget|images|documents)(/[^/]+)?$",
        "destination": "/index.html"
      }
    ],
    "redirects": [
      {
        "regex": "^/(plan|furniture|todo|budget|images|documents)((?:/[^/]+)?)/+$",
        "destination": "/:1:2",
        "type": 301
      }
    ]
  }
}
